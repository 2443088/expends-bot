# Salin nilai-nilai ini ke Vercel > Settings > Environment Variables. JANGAN isi file ini dengan data asli lalu upload ke GitHub.

# 1. Token dari @BotFather
TELEGRAM_BOT_TOKEN=

# 2. Kunci AI dari aistudio.google.com/apikey
GEMINI_API_KEY=

# 3. ID file Google Sheets (bagian panjang di antara /d/ dan /edit pada alamat)
GOOGLE_SHEET_ID=

# 4 & 5. Dari file JSON service account: client_email dan private_key
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# 6. Angka ID Telegram kamu (dari @userinfobot)
ADMIN_TELEGRAM_ID=

# 7. Kata sandi acak buatanmu sendiri (huruf/angka/_/-, 24+ karakter). Sama persis dengan secret_token saat setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Opsional
# BOT_TZ=Asia/Makassar     (default Asia/Makassar = WITA; pakai Asia/Jakarta untuk WIB, Asia/Jayapura untuk WIT)
# GEMINI_MODEL=gemini-2.5-flash
